{
  "name": "project-prototype-gaborone",
  "version": "0.1.0",
  "private": true,
  "description": "Project Prototype — an interactive monochrome map of Gaborone. Electron desktop shell + Vite/TypeScript web app + MapLibre + Firebase.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:web": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p electron/tsconfig.json && cross-env VITE_DEV_SERVER=http://localhost:5173 electron .",
    "build:web": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:web && npm run build:electron",
    "preview": "vite preview",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:new": "supabase migration new"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "@supabase/supabase-js": "^2.46.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1",
    "@types/geojson": "^7946.0.15",
    "@types/three": "^0.171.0"
  },
  "build": {
    "appId": "bw.gaborone.prototype",
    "productName": "Project Prototype",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.navigation"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
