# ---- Supabase (Project settings -> API) ----
# The anon key is PUBLIC by design — access is governed by Row Level Security,
# not by hiding it. Never put the service_role key in a VITE_ var (it bypasses RLS).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional Pandora proxy endpoint. This must be a server you control that signs
# Pandora ingestion requests; never put a Pandora HMAC secret in VITE_ env.
VITE_PANDORA_PROXY_URL=
